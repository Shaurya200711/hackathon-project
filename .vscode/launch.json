{
  "manifest_version": 3,
  "name": "TabFlow Manager",
  "version": "1.0.0",
  "description": "Smart tab manager for searching, closing, deduplicating, and auto-grouping tabs.",
  "permissions": [
    "tabs",
    "tabGroups",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Open TabFlow Manager"
  },
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+T",
        "mac": "Option+Shift+T"
      },
      "description": "Open TabFlow popup"
    }
  }
}